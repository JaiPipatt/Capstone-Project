# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.log
*.synctex.gz
*.out
*.toc
*.bbl
*.blg
*.lof
*.lot
*.nav
*.snm
*.vrb
*.gz
*.mdtstex_modules/

# ROS 2
**/build/
**/install/
**/log/

# Python
__pycache__/
*.py[cod]

# Editor settings (any folder)
.vscode/
.settings/

.env
sdkconfig.defaults

# ESP-IDF (embedding/esp32c6)
# sdkconfig is generated by idf.py and contains the Wi-Fi password -> never commit
**/sdkconfig
**/sdkconfig.old
**/sdkconfig.defaults.local
**/managed_components/
**/dependencies.lock.bak

# STM32 / CubeMX / CMake (embedding/stm32)
**/Debug/
**/Release/
*.elf
*.bin
*.hex
*.map
*.list
.clangd
.cache/
compile_commands.json
.idea/

# Unused CMSIS packs that CubeMX may copy back on regenerate
# (set CubeMX > Project Manager > Code Generator > "Copy only the necessary library files")
embedding/stm32/**/Drivers/CMSIS/DSP/
embedding/stm32/**/Drivers/CMSIS/NN/
embedding/stm32/**/Drivers/CMSIS/RTOS/
embedding/stm32/**/Drivers/CMSIS/RTOS2/
embedding/stm32/**/Drivers/CMSIS/DAP/
embedding/stm32/**/Drivers/CMSIS/Core_A/
embedding/stm32/**/Drivers/CMSIS/Core/
embedding/stm32/**/Drivers/CMSIS/Documentation/

# OS junk
.DS_Store
Thumbs.db

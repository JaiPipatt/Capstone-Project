    </visual>
    <collision>
      <origin xyz="0 0.00425 0" rpy="0 0 -1.570796" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/left_wheel_collision.stl" />
      </geometry>
    </collision>
  </link>

  <link name="right_wheel">
    <inertial>
      <origin xyz="0.000000 -0.001125 0.000000" rpy="0 0 0" />
      <mass value="0.051660" />
      <inertia ixx="3.5725e-05" ixy="-1.1472e-11" ixz="-2.2746e-07" iyy="7.0049e-05" iyz="-1.0834e-12" izz="3.5261e-05" />
    </inertial>
    <visual>
      <origin xyz="0 0.00075 0" rpy="-1.570796 -1.570796 0" />
      <geometry>

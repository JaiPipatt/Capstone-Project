<robot name="my_robot">
  <!--
    Frame convention (REP-103): every link frame is aligned with base_link
    at zero joint position -> x forward, y left, z up.
    The CAD export orientation of each mesh lives in its visual/collision
    origin, NOT in the joint, so the TF tree stays clean.
  -->

  <!-- Links -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.025845 -0.000006 0.052571" rpy="0 0 0" />
      <mass value="0.141348" />
      <inertia ixx="2.5098e-04" ixy="1.8586e-08" ixz="-1.9180e-08" iyy="2.0529e-04" iyz="-1.9254e-09" izz="2.5711e-04" />
    </inertial>
    <visual>
      <origin xyz="-0.007407 0 0.052843" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/base_link_visual.obj" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.007407 0 0.052841" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/base_link_collision.stl" />
      </geometry>
    </collision>
  </link>

  <link name="left_wheel">

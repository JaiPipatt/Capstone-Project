  </link>

  <link name="pan_face">
    <inertial>
      <origin xyz="-0.004029 0.000000 0.000000" rpy="0 0 0" />
      <mass value="0.037477" />
      <inertia ixx="4.3570e-05" ixy="3.1446e-11" ixz="-4.4667e-12" iyy="2.2137e-05" iyz="1.3693e-11" izz="2.2237e-05" />
    </inertial>
    <visual>
      <origin xyz="-0.007875 0 0" rpy="1.570796 0 -1.570796" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/pan_face_visual.obj" />

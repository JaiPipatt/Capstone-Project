      <geometry>
        <mesh filename="package://my_robot_description/meshes/right_wheel_collision.stl" />
      </geometry>
    </collision>
  </link>

  <link name="tilt_body">
    <inertial>
      <origin xyz="0.025071 -0.000001 0.000000" rpy="0 0 0" />
      <mass value="0.028671" />
      <inertia ixx="3.4623e-05" ixy="6.4784e-10" ixz="-6.4375e-11" iyy="2.8181e-05" iyz="-7.3079e-12" izz="3.3263e-05" />
    </inertial>
    <visual>
      <origin xyz="0.006875 0 0" rpy="0 3.141593 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/tilt_body_visual.obj" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.006816 0 -0.000076" rpy="0 3.141593 0" />

<?xml version="1.0"?>
<!--
  Robot: my_robot
  Generated by: LinkForge
  https://github.com/arounamounchili/linkforge
-->
<robot name="my_robot">
  <!--
    Frame convention (REP-103): every link frame is aligned with base_link
    at zero joint position -> x forward, y left, z up.
    The CAD export orientation of each mesh lives in its visual/collision
    origin, NOT in the joint, so the TF tree stays clean.
  -->

  <!-- Links -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.007407 0 0.052843" rpy="0 0 0" />
      <mass value="0.188891" />
      <inertia ixx="0.031482" ixy="0" ixz="0" iyy="0.031482" iyz="0" izz="0.031482" />
    </inertial>
    <visual>
      <origin xyz="-0.007407 0 0.052843" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/base_link_visual.obj" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.007407 0 0.052841" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/base_link_collision.stl" />
      </geometry>
    </collision>
  </link>

  <link name="left_wheel">
    <inertial>
      <origin xyz="0 0.00425 0" rpy="0 0 0" />
      <mass value="0.056299" />
      <inertia ixx="0.009383" ixy="0" ixz="0" iyy="0.009383" iyz="0" izz="0.009383" />
    </inertial>
    <visual>
      <origin xyz="0 0.00425 0" rpy="0 0 -1.570796" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/left_wheel_visual.obj" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.00425 0" rpy="0 0 -1.570796" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/left_wheel_collision.stl" />
      </geometry>
    </collision>
  </link>

  <link name="right_wheel">
    <inertial>
      <origin xyz="0 0.00075 0" rpy="0 0 0" />
      <mass value="0.056299" />
      <inertia ixx="0.009383" ixy="0" ixz="0" iyy="0.009383" iyz="0" izz="0.009383" />
    </inertial>
    <visual>
      <origin xyz="0 0.00075 0" rpy="-1.570796 -1.570796 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/right_wheel_visual.obj" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0.00075 0" rpy="-1.570796 -1.570796 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/right_wheel_collision.stl" />
      </geometry>
    </collision>
  </link>

  <link name="tilt_body">
    <inertial>
      <origin xyz="0.006875 0 0" rpy="0 0 0" />
      <mass value="0.035226" />
      <inertia ixx="0.005871" ixy="0" ixz="0" iyy="0.005871" iyz="0" izz="0.005871" />
    </inertial>
    <visual>
      <origin xyz="0.006875 0 0" rpy="0 3.141593 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/tilt_body_visual.obj" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.006816 0 -0.000076" rpy="0 3.141593 0" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/tilt_body_collision.stl" />
      </geometry>
    </collision>
  </link>

  <link name="pan_face">
    <inertial>
      <origin xyz="-0.007875 0 0" rpy="0 0 0" />
      <mass value="0.038477" />
      <inertia ixx="0.006413" ixy="0" ixz="0" iyy="0.006413" iyz="0" izz="0.006413" />
    </inertial>
    <visual>
      <origin xyz="-0.007875 0 0" rpy="1.570796 0 -1.570796" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/pan_face_visual.obj" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.007875 0 0" rpy="1.570796 0 -1.570796" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/pan_face_collision.stl" />
      </geometry>
    </collision>
  </link>

  <!-- Joints (all rpy = 0: child frames are aligned with the parent) -->
  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="-0.004905 0.0422 0.05257" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="left_wheel" />
    <axis xyz="0 1 0" />
    <limit effort="10" velocity="1" />
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="-0.004905 -0.0472 0.05257" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="right_wheel" />
    <axis xyz="0 1 0" />
    <limit effort="10" velocity="1" />
  </joint>

  <joint name="tilt_body_joint" type="revolute">
    <origin xyz="-0.004905 0 0.05257" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="tilt_body" />
    <axis xyz="0 -1 0" />
    <limit effort="10" velocity="1" lower="-3.141593" upper="3.141593" />
  </joint>

  <joint name="pan_face_joint" type="continuous">
    <origin xyz="0.05275 0 0" rpy="0 0 0" />
    <parent link="tilt_body" />
    <child link="pan_face" />
    <axis xyz="-1 0 0" />
    <limit effort="10" velocity="1" />
  </joint>

  <!-- Disable collisions between this robot's own links. External collisions remain enabled. -->
  <gazebo reference="base_link">
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="left_wheel">
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="pan_face">
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="right_wheel">
    <selfCollide>false</selfCollide>
  </gazebo>
  <gazebo reference="tilt_body">
    <selfCollide>false</selfCollide>
  </gazebo>
  
  <!-- ROS 2 Control -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="left_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="pan_face_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="right_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="tilt_body_joint">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>
  <!-- Gazebo Extensions -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find robot_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
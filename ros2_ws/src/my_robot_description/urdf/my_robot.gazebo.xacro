<?xml version="1.0"?>
<!-- Gazebo (Fortress) settings -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Disable collisions between this robot's own links. External collisions remain enabled. -->
  <xacro:macro name="no_self_collide" params="link">
    <gazebo reference="${link}">
      <selfCollide>false</selfCollide>
    </gazebo>
  </xacro:macro>

  <xacro:no_self_collide link="base_link" />
  <xacro:no_self_collide link="tilt_body" />
  <xacro:no_self_collide link="pan_face" />

  <!-- Wheels: grippy rubber-like contact so they roll instead of slide -->
  <xacro:macro name="wheel_contact" params="link">
    <gazebo reference="${link}">
      <selfCollide>false</selfCollide>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_contact link="left_wheel" />
  <xacro:wheel_contact link="right_wheel" />

  <gazebo>
    <!-- One controller_manager per module, inside the module's namespace -->
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find my_robot_description)/config/controllers.yaml</parameters>
      <ros>
        <namespace>/${namespace}</namespace>
      </ros>
    </plugin>

    <!--
      Ground-truth pose ("known exact location") straight from the physics engine,
      published as Gazebo odometry and as TF world -> <prefix>base_link.
      The launch file bridges both to ROS.
    -->
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>${frame_prefix}base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

</robot>

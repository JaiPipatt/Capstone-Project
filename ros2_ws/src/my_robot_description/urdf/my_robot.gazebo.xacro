<?xml version="1.0"?>
<!-- Gazebo (Fortress) settings -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Disable collisions between this robot's own links. External collisions remain enabled. -->
  <xacro:macro name="no_self_collide" params="link">
    <gazebo reference="${link}">
      <selfCollide>false</selfCollide>
    </gazebo>
  </xacro:macro>

  <xacro:no_self_collide link="base_link" />
  <xacro:no_self_collide link="tilt_body" />
  <xacro:no_self_collide link="pan_face" />

  <!-- Wheels: grippy rubber-like contact so they roll instead of slide -->
  <xacro:macro name="wheel_contact" params="link">
    <gazebo reference="${link}">
      <selfCollide>false</selfCollide>
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_contact link="left_wheel" />
  <xacro:wheel_contact link="right_wheel" />

  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find my_robot_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>

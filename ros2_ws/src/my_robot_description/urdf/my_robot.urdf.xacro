<?xml version="1.0"?>
<!--
  my_robot - two-wheeled base with a tilt body and a pan face.

  Build the plain URDF with:
    xacro my_robot.urdf.xacro > my_robot.urdf
  For one module of many in simulation:
    xacro my_robot.urdf.xacro namespace:=module_1
-->
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ROS namespace of this module, e.g. module_1. Empty for a single robot. -->
  <xacro:arg name="namespace" default="" />
  <xacro:property name="namespace" value="$(arg namespace)" />
  <xacro:property name="frame_prefix" value="${namespace + '/' if namespace else ''}" />

  <xacro:include filename="$(find my_robot_description)/urdf/inertial.xacro" />
  <xacro:include filename="$(find my_robot_description)/urdf/my_robot_core.xacro" />
  <xacro:include filename="$(find my_robot_description)/urdf/my_robot.ros2_control.xacro" />
  <xacro:include filename="$(find my_robot_description)/urdf/my_robot.gazebo.xacro" />

</robot>

<?xml version="1.0"?>
<!--
  Links and joints.

  Frame convention (REP-103): every link frame is aligned with base_link
  at zero joint position -> x forward, y left, z up.
  The CAD export orientation of each mesh lives in its visual/collision
  origin, NOT in the joint, so the TF tree stays clean.

  Inertial blocks come from inertial.xacro (generated by scripts/compute_inertia.py).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Joint locations [m] -->
  <xacro:property name="axle_x" value="-0.004905" />        <!-- wheels and tilt share one axis -->
  <xacro:property name="axle_z" value="0.05257" />
  <xacro:property name="left_wheel_y" value="0.0422" />
  <xacro:property name="right_wheel_y" value="-0.0472" />
  <xacro:property name="pan_face_x" value="0.05275" />      <!-- from tilt_body origin -->

  <!-- Actuator limits -->
  <xacro:property name="effort_limit" value="10" />
  <xacro:property name="velocity_limit" value="1" />

  <!-- Mesh orientations from the CAD export -->
  <xacro:property name="half_pi" value="${pi / 2}" />

  <!--
    Visual + collision for a link whose meshes are named meshes/<name>_visual.obj
    and meshes/<name>_collision.stl. collision_xyz defaults to xyz.
  -->
  <xacro:macro name="link_meshes" params="name xyz rpy collision_xyz:=''">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/${name}_visual.obj" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="${collision_xyz or xyz}" rpy="${rpy}" />
      <geometry>
        <mesh filename="package://my_robot_description/meshes/${name}_collision.stl" />
      </geometry>
    </collision>
  </xacro:macro>

  <!-- Drive wheel: rotates about +y, positive velocity drives forward -->
  <xacro:macro name="wheel" params="side y mesh_xyz mesh_rpy">
    <link name="${side}_wheel">
      <xacro:call macro="${side}_wheel_inertial" />
      <xacro:link_meshes name="${side}_wheel" xyz="${mesh_xyz}" rpy="${mesh_rpy}" />
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <origin xyz="${axle_x} ${y} ${axle_z}" rpy="0 0 0" />
      <parent link="base_link" />
      <child link="${side}_wheel" />
      <axis xyz="0 1 0" />
      <limit effort="${effort_limit}" velocity="${velocity_limit}" />
    </joint>
  </xacro:macro>

  <!-- Base -->
  <link name="base_link">
    <xacro:base_link_inertial />
    <xacro:link_meshes name="base_link"
      xyz="-0.007407 0 0.052843" rpy="0 0 0"
      collision_xyz="-0.007407 0 0.052841" />
  </link>

  <!-- Wheels -->
  <xacro:wheel side="left" y="${left_wheel_y}"
    mesh_xyz="0 0.00425 0" mesh_rpy="0 0 ${-half_pi}" />
  <xacro:wheel side="right" y="${right_wheel_y}"
    mesh_xyz="0 0.00075 0" mesh_rpy="${-half_pi} ${-half_pi} 0" />

  <!-- Tilt body: pitches about the wheel axle -->
  <link name="tilt_body">
    <xacro:tilt_body_inertial />
    <xacro:link_meshes name="tilt_body"
      xyz="0.006875 0 0" rpy="0 ${pi} 0"
      collision_xyz="0.006816 0 -0.000076" />
  </link>

  <joint name="tilt_body_joint" type="revolute">
    <origin xyz="${axle_x} 0 ${axle_z}" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="tilt_body" />
    <axis xyz="0 -1 0" />
    <limit effort="${effort_limit}" velocity="${velocity_limit}" lower="${-pi}" upper="${pi}" />
  </joint>

  <!-- Pan face: spins about the forward axis at the front of the tilt body -->
  <link name="pan_face">
    <xacro:pan_face_inertial />
    <xacro:link_meshes name="pan_face"
      xyz="-0.007875 0 0" rpy="${half_pi} 0 ${-half_pi}" />
  </link>

  <joint name="pan_face_joint" type="continuous">
    <origin xyz="${pan_face_x} 0 0" rpy="0 0 0" />
    <parent link="tilt_body" />
    <child link="pan_face" />
    <axis xyz="-1 0 0" />
    <limit effort="${effort_limit}" velocity="${velocity_limit}" />
  </joint>

</robot>
